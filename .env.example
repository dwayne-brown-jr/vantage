# ── Vantage environment ──────────────────────────────────────────
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
#   cp .env.example .env.local
#
# The Anthropic API key is used ONLY on the server (route handlers).
# It is never exposed to the browser. Do not prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Password gate. When set, the whole app requires this password to view (login
# screen + signed cookie). REQUIRED in any hosted/public deployment so your
# financial data isn't world-readable. Leave unset for local dev to skip login.
# VANTAGE_PASSWORD=choose-a-strong-passphrase

# Optional: override the strategist model (defaults to claude-sonnet-4-6).
# VANTAGE_STRATEGIST_MODEL=claude-sonnet-4-6

# Optional: force the persistence backend. Defaults to SQLite locally and
# Netlify Blobs on Netlify. Values: "blobs" | "sqlite".
# VANTAGE_STORE=sqlite

# Optional: path to the local SQLite database file (defaults to ./data/vantage.db).
# VANTAGE_DB_PATH=./data/vantage.db
