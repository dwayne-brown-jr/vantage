# ── Vantage environment ──────────────────────────────────────────
# Copy this file to `.env.local` (which is gitignored) and fill in real values.
#   cp .env.example .env.local
#
# The Anthropic API key is used ONLY on the server (route handlers).
# It is never exposed to the browser. Do not prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the strategist model (defaults to claude-sonnet-4-6).
# VANTAGE_STRATEGIST_MODEL=claude-sonnet-4-6

# Optional: path to the local SQLite database file (defaults to ./data/vantage.db).
# VANTAGE_DB_PATH=./data/vantage.db
