# ───────────────────────────────────────────────────────────────
# Vantage — keep ALL financial data and secrets off version control.
# This is a single-user, local-first tool. Nothing private leaves the machine.
# ───────────────────────────────────────────────────────────────

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js / build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# ── secrets (API keys etc.) ──
.env
.env.*
!.env.example

# ── the local database (your holdings live here) ──
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── broker exports / imports / snapshots (contain real financial data) ──
/imports/
/exports/
*.csv
*.xls
*.xlsx
*.ofx
*.qfx
# …but DO allow synthetic test fixtures (safe, fake data only)
!tests/**/*.csv
!**/__fixtures__/**/*.csv

# testing / coverage
/coverage
*.lcov

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea
